# Copy to .env.runtime on the host and fill in real values.
# Do NOT commit .env.runtime.
OPENAI_API_BASE_URL=http://host.docker.internal:8642/v1
OPENAI_API_KEY=replace-me
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
ENABLE_FORWARD_USER_INFO_HEADERS=true
ENABLE_OLLAMA_API=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
AUXILIARY_EMBEDDING_MODEL=TaylorAI/bge-micro-v2
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HOST_BIND_IP=10.13.37.106
HOST_BIND_PORT=3000
IMAGE_TAG=local-hermes-delete-hook
CONTAINER_NAME=open-webui
DATA_VOLUME=open-webui
